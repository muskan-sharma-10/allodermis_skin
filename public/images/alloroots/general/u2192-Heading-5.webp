<script>
  (function(){
    var hamburgerBtn = document.getElementById('alloroots-hamburgerBtn');
    var closeBtn = document.getElementById('alloroots-closeBtn');
    var overlay = document.getElementById('alloroots-menuOverlay');

    hamburgerBtn.addEventListener('click', function(){
      overlay.classList.add('open');
      hamburgerBtn.classList.add('active');
      document.body.style.overflow = 'hidden';
    });
    closeBtn.addEventListener('click', function(){
      overlay.classList.remove('open');
      hamburgerBtn.classList.remove('active');
      document.body.style.overflow = '';
    });

    var items = document.querySelectorAll('#alloroots-nav .menu-list > li, #alloroots-nav .submenu > li');
    items.forEach(function(li){
      var row = li.querySelector(':scope > .menu-row');
      var hasChildren = li.querySelector(':scope > .submenu, :scope > .subsubmenu');
      if (hasChildren) {
        row.addEventListener('click', function(e){
          e.preventDefault();
          li.classList.toggle('open');
        });
      }
    });
  })();
</script>		</div>
